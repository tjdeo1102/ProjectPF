  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uD5A5\uC218 \uC870\uD569\uBC95\n\n* \uD5A5\uC218\uB294 \uB178\uD2B8\uB85C\uB9CC
    \uC870\uD569 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n* \uC81C\uC870\uB294 \uBE46\uC5D0
    \uC788\uB294 \uD5A5\uC218\uBCD1\uC744 \uD1B5\uD574\uC11C \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n*
    \uC870\uD569\uC740 \uC7AC\uB8CC\uB97C \uC54C\uB9DE\uAC8C \uB123\uACE0 Shake!\n\nRed\uD5A5\uC218
    = \uC2DC\uD2B8\uB7EC\uC2A4 1 + \uADF8\uB9B0 1 + \uD50C\uB85C\uB7F4 3\nPurple\uD5A5\uC218
    = \uADF8\uB9B0 2 + \uC6B0\uB514 3\nApricot\uD5A5\uC218 = \uC2DC\uD2B8\uB7EC\uC2A4
    1 + \uADF8\uB9B0 1 + \uD478\uB974\uD2F0 3\nGreen\uD5A5\uC218 = \uC6B0\uB514 1
    + \uD50C\uB85C\uB7F4 1 + \uADF8\uB9B0 3\nAqua\uD5A5\uC218 = \uADF8\uB9B0 2 +
    \uC2DC\uD2B8\uB7EC\uC2A4 3\nPink\uD5A5\uC218 = \uC2DC\uD2B8\uB7EC\uC2A4 1 + \uC6B0\uB514
    2 + \uD50C\uB85C\uB7F4 2 \nBlue\uD5A5\uC218 = \uADF8\uB9B0 1 + \uD478\uB974\uD2F0
    2 + \uD50C\uB85C\uB7F4 2\nYellow\uD5A5\uC218 = \uD50C\uB85C\uB7F4 1 + \uD478\uB974\uD2F0
    2 + \uC2DC\uD2B8\uB7EC\uC2A4 2\nLightNavy\uD5A5\uC218 = \uD478\uB974\uD2F0 1
    + \uC6B0\uB514 2 + \uADF8\uB9B0 2 "
  m_isRightToLeft: 0
