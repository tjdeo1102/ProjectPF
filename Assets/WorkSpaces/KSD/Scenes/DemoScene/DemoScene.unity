  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC6D0\uC561 \uC870\uD569\uBC95\n\n* \uBAA8\uB4E0 \uC7AC\uB8CC\uB294 \uAC00\uB3D9\uB41C
    \uC0C1\uD0DC\uC5D0\uC11C\uB9CC \uC870\uD569 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n*
    \uC6D0\uC561 \uC81C\uC870\uB294 \uC6D0\uC561\uBCD1\uC744 \uD1B5\uD574\uC11C\uB9CC
    \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n\nFloral\uC6D0\uC561 = \uCF54\uC2A4\uBAA8\uC2A4+
    \uC7A5\uBBF8\nFruity\uC6D0\uC561 = \uCCB4\uB9AC + \uBE14\uB8E8\uBCA0\uB9AC\nCitrus\uC6D0\uC561
    = \uB808\uBAAC + \uC790\uBABD\nWoody\uC6D0\uC561 = \uAC08\uBC14\uB118 + \uB098\uBB34\uAECD\uC9C8\nGreen\uC6D0\uC561
    = \uB124\uB864\uB9AC + \uB179\uCC28\uC78E\n\n\uBBF9\uC11C\uAE30 \uC774\uC6A9\uBC95\n1.
    \uC704\uCABD\uC5D0 \uC791\uC740\uACFC\uC77C \uB123\uAE30\n2. \uC561\uCCB4\uAC00
    \uB098\uC624\uB294 \uACF3\uC5D0 \uC561\uCCB4 \uC7AC\uB8CC\uBCD1\uC744 \uB193\uAE30\n3.
    \uC67C\uCABD \uC190\uC7A1\uC774\uB97C \uC7A1\uACE0 \uB3CC\uB9AC\uAE30 (\uD611\uB3D9\uAE30\uB2A5
    \uBBF8\uAD6C\uD604)"
