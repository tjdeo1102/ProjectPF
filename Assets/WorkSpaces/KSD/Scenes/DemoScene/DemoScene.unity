  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB178\uD2B8 \uC870\uD569\uBC95\n\n* \uBAA8\uB4E0 \uC7AC\uB8CC\uB294 \uC6D0\uC561\uBCD1\uC5D0
    \uC788\uB294 \uC7AC\uB8CC\uB85C\uB9CC \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n* \uC870\uD569\uC740
    \uAC00\uB9C8\uC1A5\uC744 \uD1B5\uD574\uC11C\uB9CC \uAC00\uB2A5\uD569\uB2C8\uB2E4.\n*
    \uC54C\uCF54\uC62C\uC740 \uC54C\uCF54\uC62C \uCD94\uCD9C\uAE30\uB85C \uBC1B\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\nFloral\uB178\uD2B8 = \uC6D0\uC561 1 + \uC54C\uCF54\uC62C
    3\nFruity\uB178\uD2B8 = \uC6D0\uC561 1 + \uC54C\uCF54\uC62C 2\nCitrus\uB178\uD2B8
    = \uC6D0\uC561 1 + \uC54C\uCF54\uC62C 1\nWoody\uB178\uD2B8 = \uC6D0\uC5611 +
    \uC54C\uCF54\uC62C 2\nGreen\uB178\uD2B8 = \uC6D0\uC5611 + \uC54C\uCF54\uC62C
    2\n\n\uAC00\uB9C8\uC1A5 \uC774\uC6A9\uBC95\n1. \uC7AC\uB8CC\uB97C \uAC00\uB9C8\uC1A5\uC5D0
    \uBD93\uAE30\n2. \uD55C\uBA85\uC774 \uBD80\uCC44\uC9C8 \uB2E4\uB978 \uD55C\uBA85\uC740
    \uAD6D\uC790\uB97C \uB4E4\uACE0 \uC11E\uAE30\n3. \uC644\uC131\uB41C \uC7AC\uB8CC\uB97C
    \uC591\uB3D9\uC774\uB85C \uAC74\uC838\uB0B4\uAE30"
